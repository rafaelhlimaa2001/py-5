"""Testes automatizados: python3 -m unittest -v"""

import os
import tempfile
import unittest
from datetime import date

import analise_dados as ad

HOJE = date(2026, 10, 13)


class TestEmail(unittest.TestCase):
    def test_validos(self):
        for texto in ("ana@email.com", "a.b+c@sub.dominio.com.br",
                      "x_y-z@uol.com.br"):
            self.assertEqual(ad.validar_email(texto), texto.lower())

    def test_invalidos(self):
        for texto in ("", "ana@email", "ana@@email.com", "@email.com",
                      "ana@.com", "ana..x@email.com", "ana @email.com",
                      "ana@email.c", "ana@email.com\n"):
            with self.assertRaises(ad.FormatoInvalidoError, msg=texto):
                ad.validar_email(texto)


class TestCpf(unittest.TestCase):
    def test_validos_formatados_e_sem_formato(self):
        self.assertEqual(ad.validar_cpf("52998224725"), "529.982.247-25")
        self.assertEqual(ad.validar_cpf("529.982.247-25"), "529.982.247-25")

    def test_formato_invalido(self):
        for texto in ("", "529.982.24725", "529982.247-25", "1234567890",
                      "abc.def.ghi-jk"):
            with self.assertRaises(ad.FormatoInvalidoError, msg=texto):
                ad.validar_cpf(texto)

    def test_digitos_verificadores(self):
        for texto in ("123.456.789-00", "111.111.111-11"):
            with self.assertRaises(ad.DocumentoInvalidoError, msg=texto):
                ad.validar_cpf(texto)


class TestTelefone(unittest.TestCase):
    def test_validos(self):
        for texto in ("(11) 91234-5678", "(11)91234-5678", "11912345678",
                      "1132345678", "(21) 3456-7890", "+55 11 91234-5678",
                      "+5511912345678"):
